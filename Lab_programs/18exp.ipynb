      "source": [
        "import re\n",
        "\n",
        "expression = input(\"Enter expression: \")\n",
        "\n",
        "pattern = r'^[A-Za-z]+\\([a-z]\\)$'\n",
        "\n",
        "if re.match(pattern, expression):\n",
        "    print(\"Valid Predicate Expression\")\n",
        "else:\n",
        "    print(\"Invalid Predicate Expression\")"
      ]
    }
