          "text": [
            "Enter a sentence: Sundar Pichai works at Google\n",
            "Sundar Pichai -> PERSON\n",
            "Google -> ORG\n"
          ]
        }
      ],
      "source": [
        "import spacy\n",
        "\n",
        "nlp = spacy.load(\"en_core_web_sm\")\n",
        "\n",
        "text = input(\"Enter a sentence: \")\n",
        "\n",
        "doc = nlp(text)\n",
        "\n",
        "for entity in doc.ents:\n",
        "    print(entity.text, \"->\", entity.label_)"
      ]
    }
  ]
}