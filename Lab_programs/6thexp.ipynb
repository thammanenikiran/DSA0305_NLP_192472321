            "Enter words separated by space: running playing connected studies\n",
            "Word\tStem\n",
            "----------------\n",
            "running \t run\n",
            "playing \t play\n",
            "connected \t connect\n",
            "studies \t studi\n"
          ]
        }
      ],
      "source": [
        "from nltk.stem import PorterStemmer\n",
        "\n",
        "stemmer = PorterStemmer()\n",
        "\n",
        "text = input(\"Enter words separated by space: \")\n",
        "\n",
        "words = text.split()\n",
        "\n",
        "print(\"Word\\tStem\")\n",
        "print(\"----------------\")\n",
        "\n",
        "for word in words:\n",
        "    stem = stemmer.stem(word)\n",
        "    print(word, \"\\t\", stem)"
      ]
    }
  ]
}