      "source": [
        "import nltk\n",
        "from nltk.corpus import wordnet\n",
        "\n",
        "nltk.download(\"wordnet\")\n",
        "\n",
        "word = input(\"Enter a word: \")\n",
        "\n",
        "synsets = wordnet.synsets(word)\n",
        "\n",
        "for synset in synsets[:5]:\n",
        "    print(\"\\nSynset:\", synset.name())\n",
        "    print(\"Meaning:\", synset.definition())"
      ]
    }
  ]
